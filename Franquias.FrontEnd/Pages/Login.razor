@page "/login"
@using Blazored.LocalStorage <!-- Essa é a linha mágica que faltava! -->
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager NavManager

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="4" Class="pa-8 rounded-lg">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true"><b>Acesso Restrito</b></MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">Faça login para acessar o painel gerencial.</MudText>
        
        <MudTextField @bind-Value="loginModel.Email" Label="E-mail Corporativo" Variant="Variant.Outlined" Class="mb-4" />
        <MudTextField @bind-Value="loginModel.Senha" Label="Senha" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-4" />
        
        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <MudText Color="Color.Error" Align="Align.Center" Class="mb-4">@mensagemErro</MudText>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="FazerLogin">Entrar no Sistema</MudButton>
    </MudCard>
</MudContainer>

@code {
    private LoginRequest loginModel = new();
    private string mensagemErro = "";

    private async Task FazerLogin()
    {
        mensagemErro = ""; // Limpa os erros

        // Bate lá na sua API usando o endereço configurado no Program.cs
        var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);
        
        if (response.IsSuccessStatusCode)
        {
            // Se deu sucesso, pega o token gerado!
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                // Guarda o token no cofre do navegador e vai para a página inicial
                await LocalStorage.SetItemAsStringAsync("authToken", result.Token);
                NavManager.NavigateTo("/");
            }
        }
        else
        {
            mensagemErro = "E-mail ou senha incorretos. Tente novamente.";
        }
    }

    // Classes auxiliares para enviar e receber os dados no formato exato que a API espera
    public class LoginRequest
    {
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; } = "";
    }
}