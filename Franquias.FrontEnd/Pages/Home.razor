@page "/"

<MudText Typo="Typo.h3" GutterBottom="true">Dashboard Gerencial</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-8">Visão geral da rede de franquias.</MudText>

<MudGrid>
    <!-- Cartão 1: Unidades -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="pa-4 rounded-lg">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">Unidades Ativas</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Primary" Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="mt-4">3</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Cartão 2: Faturamento -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="pa-4 rounded-lg">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">Faturamento Mensal</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h3" Color="Color.Success" Class="mt-4">R$ 11.350</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Cartão 3: Alertas -->
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="pa-4 rounded-lg">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">Chamados Abertos</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Large" />
                </div>
                <MudText Typo="Typo.h3" Color="Color.Error" Class="mt-4">1</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>